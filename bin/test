#!/usr/bin/env bash

set -e

cd "$(dirname "$0")/.."

function print_usage {
  echo "Usage: bin/test [type] [options]"
  echo ""
  echo "Test types:"
  echo "  unit      - Run backend unit tests (models, services, controllers)"
  echo "  api       - Run backend API/integration tests"
  echo "  system    - Run Rails system tests (requires test server)"
  echo "  e2e       - Run Playwright E2E tests (requires test server)"
  echo "  all       - Run all tests (unit + api, then system + e2e with test server)"
  echo ""
  echo "Options:"
  echo "  --help    - Show this help"
  echo "  --setup   - Setup test environment first"
  echo ""
  echo "Examples:"
  echo "  bin/test unit                    # Run unit tests only"
  echo "  bin/test system                  # Run system tests (needs test server)"
  echo "  bin/test e2e --setup             # Setup environment then run E2E tests"
  echo "  bin/test all                     # Run all tests"
  echo ""
  echo "Note: system and e2e tests require 'bin/test_server' to be running"
  echo "      in another terminal, or use 'bin/test all' to run everything."
}

export NODE_TLS_REJECT_UNAUTHORIZED=0
export RAILS_ENV=test
export NODE_ENV=test

function setup_test_env {
  echo "🔧 Setting up test environment..."

  # Install dependencies
  pnpm install
  cd backend && bundle install && cd ..

  # Setup environment files
  if [ ! -f .env ]; then
    cp .env.example .env
  fi

  if [ ! -L frontend/.env ]; then
    ln -sf $PWD/.env ./frontend/.env
  fi

  # Setup test database
  cd backend
  RAILS_ENV=test bundle exec rails db:drop db:create db:schema:load db:seed_test_data
  cd ..

  echo "✅ Test environment setup complete"
}

function run_unit_tests {
  echo "🧪 Running backend unit tests..."
  cd backend
  RAILS_ENV=test bundle exec rspec --format progress --no-profile spec/models/ spec/policies/ spec/services/ spec/sidekiq/ spec/support/
  cd ..
}

function run_api_tests {
  echo "🔌 Running backend API tests..."
  cd backend
  RAILS_ENV=test bundle exec rspec spec/controllers/ spec/requests/ --format progress --no-profile
  cd ..
}

function run_system_tests {
  echo "🖥️  Running Rails system tests..."
  if ! check_test_server; then
    echo "❌ Test server not running. Please run 'bin/test_server' in another terminal first."
    exit 1
  fi

  cd backend
  RAILS_ENV=test bundle exec rspec --tag ~skip --tag ~type:system --format progress
  cd ..
}

function run_e2e_tests {
  echo "🎭 Running Playwright E2E tests..."
  if ! check_test_server; then
    echo "❌ Test server not running. Please run 'bin/test_server' in another terminal first."
    exit 1
  fi

  pnpm playwright test e2e/tests/company/documents/documents.spec.ts e2e/tests/settings/administrator/roles.spec.ts --ui
}

function check_test_server {
  # Check if test server is running by checking if the frontend port is in use
  if lsof -i :3101 > /dev/null 2>&1; then
    return 0
  else
    return 1
  fi
}

function run_all_tests {
  echo "🚀 Running all tests..."

  # First run backend tests that don't need the test server
  run_unit_tests
  run_api_tests

  echo ""
  echo "🔄 Starting test server for system and E2E tests..."

  # Start test server in background
  bin/test_server > test_server.log 2>&1 &
  TEST_SERVER_PID=$!

  # Wait for test server to be ready
  echo "⏳ Waiting for test server to start..."
  for i in {1..60}; do
    if check_test_server; then
      echo "✅ Test server is ready"
      break
    fi
    if [ $i -eq 60 ]; then
      echo "❌ Test server failed to start within 60 seconds"
      kill $TEST_SERVER_PID 2>/dev/null || true
      exit 1
    fi
    sleep 1
  done

  # Run system and E2E tests
  run_system_tests
  run_e2e_tests

  # Clean up test server
  echo "🧹 Stopping test server..."
  kill $TEST_SERVER_PID 2>/dev/null || true
  wait $TEST_SERVER_PID 2>/dev/null || true
  rm -f test_server.log

  echo "✅ All tests completed"
}

# Parse arguments
SETUP=false
while [[ $# -gt 0 ]]; do
  case $1 in
    --help)
      print_usage
      exit 0
      ;;
    --setup)
      SETUP=true
      shift
      ;;
    unit|api|system|e2e|all)
      TEST_TYPE=$1
      shift
      ;;
    *)
      echo "Unknown option: $1"
      print_usage
      exit 1
      ;;
  esac
done

# Default to unit tests if no type specified
if [ -z "${TEST_TYPE}" ]; then
  TEST_TYPE="unit"
fi

# Setup environment if requested
if [ "$SETUP" = true ]; then
  setup_test_env
fi

# Run the requested tests
case $TEST_TYPE in
  unit)
    run_unit_tests
    ;;
  api)
    run_api_tests
    ;;
  system)
    run_system_tests
    ;;
  e2e)
    run_e2e_tests
    ;;
  all)
    run_all_tests
    ;;
  *)
    echo "Unknown test type: $TEST_TYPE"
    print_usage
    exit 1
    ;;
esac
